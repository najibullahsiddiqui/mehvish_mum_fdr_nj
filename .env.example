DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creatorpilot?schema=public"

# Cost-safe default for local development and UI testing.
LLM_PROVIDER="mock"
ALLOW_PAID_AI="false"
ALLOW_CLOUD_AI="false"
AI_MAX_RETRIES="2"
AI_REQUEST_TIMEOUT_MS="60000"

# Claude cloud LLM. To use Claude intentionally:
# LLM_PROVIDER="claude"
# ALLOW_PAID_AI="true"
# ALLOW_CLOUD_AI="true"
CLAUDE_API_KEY="your_claude_api_key_here"
CLAUDE_MODEL="claude-sonnet-4-5"

# Ollama local LLM. Requires Ollama running locally and an installed model.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL=""

# Alibaba Qwen boundary placeholder. Do not enable without official endpoint/config.
QWEN_API_KEY=""
QWEN_BASE_URL=""
QWEN_MODEL=""

# RunPod Serverless GPU execution.
# Keep RUNPOD_ENABLED=false until you intentionally want billable GPU jobs to run.
RUNPOD_ENABLED="false"
RUNPOD_API_KEY=""
RUNPOD_BASE_URL="https://api.runpod.ai/v2"
RUNPOD_VIDEO_ENDPOINT_ID=""
RUNPOD_IMAGE_ENDPOINT_ID=""
RUNPOD_VIDEO_MODEL=""
RUNPOD_REQUEST_TIMEOUT_MS="15000"
RUNPOD_EXECUTION_TIMEOUT_MS="900000"
RUNPOD_JOB_TTL_MS="3600000"
